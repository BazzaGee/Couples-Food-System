---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import FeaturesBento from '../components/sections/FeaturesBento.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import SocialProof from '../components/sections/SocialProof.astro';
import Waitlist from '../components/sections/Waitlist.astro';
import WaitlistForm from '../components/forms/WaitlistForm.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Couples Food System",
  "applicationCategory": "LifestyleApplication",
  "description": "The shared food system for couples. Plan meals together and let AI adapt portions for each partner's goals.",
  "operatingSystem": "Web Browser (PWA)",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "description": "Free during Beta"
  }
};
---

<BaseLayout title="Couples Food System | One Dinner. Two Plates. Zero Arguments." description="The shared food system for couples. Plan meals together, cook once, and let AI adapt portions for each partner's goals. Join the free Beta waitlist." schema={schema}>
  <Hero
    badge="Designed for Modern Partners"
    badgeIcon="favorite"
    headline="One dinner. Two plates. <br class='hidden md:block'/> <span class='text-primary italic'>Zero arguments.</span>"
    subheadline="Stop the &quot;I don't know, what do you want?&quot; cycle. Our system learns both your tastes and creates a shared culinary ritual."
    ctaPrimaryText="Join Free Beta Waitlist"
    ctaSecondaryText="See How It Works"
  />

  <!-- Problem Section -->
  <section class="py-xl md:py-32 bg-surface-container-low">
    <div class="max-w-7xl mx-auto px-container-padding">
      <div class="flex flex-col md:flex-row items-center gap-xl">
        <div class="w-full md:w-1/2">
          <h2 class="font-h2 text-h2 text-on-surface mb-md">The "What's for dinner?" tax is too high.</h2>
          <p class="text-body-lg text-on-surface-variant mb-lg leading-relaxed">
            Deciding what to eat shouldn't feel like a high-stakes negotiation. Between mismatched cravings, varying dietary goals, and limited energy after work, dinner has become a point of friction instead of a moment of connection.
          </p>
          <ul class="space-y-md">
            <li class="flex items-start gap-md">
              <div class="bg-primary/10 p-xs rounded-full">
                <span class="material-symbols-outlined text-primary">close</span>
              </div>
              <p class="text-body-md">Endless scrolling on delivery apps.</p>
            </li>
            <li class="flex items-start gap-md">
              <div class="bg-primary/10 p-xs rounded-full">
                <span class="material-symbols-outlined text-primary">close</span>
              </div>
              <p class="text-body-md">Mismatched diet goals causing separate cooking.</p>
            </li>
            <li class="flex items-start gap-md">
              <div class="bg-primary/10 p-xs rounded-full">
                <span class="material-symbols-outlined text-primary">close</span>
              </div>
              <p class="text-body-md">Forgotten ingredients rotting in the fridge.</p>
            </li>
          </ul>
        </div>
        <div class="w-full md:w-1/2 rounded-[32px] overflow-hidden shadow-xl">
          <div class="w-full h-[400px] bg-surface-container-highest flex items-center justify-center border border-outline-variant">
            <span class="text-on-surface-variant/50 font-medium">Collaborative Kitchen Ritual</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FeaturesBento />

  <HowItWorks />

  <SocialProof />

  <Waitlist>
    <div class="flex flex-col md:flex-row items-center justify-center gap-md relative z-10">
      <input class="w-full md:w-80 bg-white/10 border-white/20 text-white placeholder-white/60 rounded-full px-lg py-md focus:ring-2 focus:ring-secondary transition-all" type="email" placeholder="Enter your email" />
      <button class="w-full md:w-auto bg-secondary text-on-secondary px-xl py-md rounded-full font-h3 text-h3 hover:scale-105 transition-transform shadow-lg">
        Get Early Access
      </button>
    </div>
  </Waitlist>
</BaseLayout>
