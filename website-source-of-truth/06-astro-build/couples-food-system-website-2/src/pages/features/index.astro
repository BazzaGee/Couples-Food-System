---
import BaseLayout from '../../layouts/BaseLayout.astro';
import features from '../../data/features.json';
import Waitlist from '../../components/sections/Waitlist.astro';
import WaitlistForm from '../../components/forms/WaitlistForm.astro';
---

<BaseLayout title="Features | Couples Food System" description="Adaptive cooking, real-time grocery sync, pantry AI, and collaborative meal planning — all designed for couples.">
  <section class="px-container-padding max-w-7xl mx-auto mb-xxl">
    <div class="flex flex-col items-center text-center gap-md">
      <span class="px-md py-xs bg-secondary-container text-on-secondary-container rounded-full text-label-caps font-label-caps">OUR CORE SYSTEM</span>
      <h1 class="font-h1-mobile md:font-h1 text-h1-mobile md:text-h1 text-on-surface max-w-2xl text-balance">Designed for the unique chemistry of your household.</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl">Move from reactive meal planning to a shared, intentional ritual that nourishes both your body and your relationship.</p>
    </div>
  </section>

  <!-- Bento Grid Features -->
  <section class="px-container-padding max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
      <!-- 1. Adaptive Cooking -->
      <div class="md:col-span-8 bg-surface-container-low rounded-2xl p-lg border border-outline-variant group overflow-hidden relative min-h-[400px] flex flex-col justify-between">
        <div class="relative z-10 max-w-md">
          <span class="material-symbols-outlined text-primary mb-md">monitor_heart</span>
          <h3 class="font-h2 text-h2 text-on-surface mb-sm">{features.features[0].title}</h3>
          <p class="font-body-md text-on-surface-variant">{features.features[0].longDescription}</p>
        </div>
        <div class="mt-lg relative h-48 md:h-auto flex items-end justify-center">
          <div class="rounded-xl object-cover w-full h-full max-h-[250px] shadow-sm bg-surface-container-highest flex items-center justify-center">
            <span class="text-on-surface-variant/50">Adaptive meals</span>
          </div>
        </div>
      </div>
      <!-- 2. Real-Time Shared List -->
      <div class="md:col-span-4 bg-surface-container rounded-2xl p-lg border border-outline-variant flex flex-col items-center text-center">
        <div class="w-full h-full flex flex-col">
          <span class="material-symbols-outlined text-secondary mb-md">shopping_cart</span>
          <h3 class="font-h3 text-h3 text-on-surface mb-sm">Ghost List</h3>
          <p class="font-body-sm text-on-surface-variant mb-lg">Zero-lag synchronization (<100ms). See exactly what your partner is adding while you're both in the aisle.</p>
          <div class="bg-surface-container-lowest p-md rounded-xl space-y-sm text-left shadow-sm mt-auto">
            <div class="flex items-center gap-sm">
              <div class="w-4 h-4 rounded-sm border-2 border-primary bg-primary"></div>
              <span class="text-body-sm">Fresh Basil</span>
              <span class="ml-auto flex -space-x-2">
                <div class="w-6 h-6 rounded-full border-2 border-surface bg-secondary-container"></div>
                <div class="w-6 h-6 rounded-full border-2 border-surface bg-primary-container"></div>
              </span>
            </div>
            <div class="flex items-center gap-sm opacity-50">
              <div class="w-4 h-4 rounded-sm border-2 border-outline"></div>
              <span class="text-body-sm line-through">Cold Brew Coffee</span>
            </div>
          </div>
        </div>
      </div>
      <!-- 3. Collaborative Planning -->
      <div class="md:col-span-4 bg-surface-container-high rounded-2xl p-lg border border-outline-variant flex flex-col">
        <span class="material-symbols-outlined text-primary mb-md">favorite</span>
        <h3 class="font-h3 text-h3 text-on-surface mb-sm">Couples UX</h3>
        <p class="font-body-sm text-on-surface-variant mb-md">Built-in conflict resolution. Swipe on meals you both love to build a shared calendar that respects everyone's cravings.</p>
        <div class="mt-auto aspect-square rounded-2xl overflow-hidden bg-surface-container-lowest flex items-center justify-center">
          <span class="text-on-surface-variant/50">Planning together</span>
        </div>
      </div>
      <!-- 4. Pantry-First AI -->
      <div class="md:col-span-8 bg-primary-container/10 rounded-2xl p-lg border border-primary-container/20 flex flex-col md:flex-row gap-lg items-center">
        <div class="flex-1">
          <span class="material-symbols-outlined text-primary mb-md">temp_preferences_custom</span>
          <h3 class="font-h2 text-h2 text-on-surface mb-sm">{features.features[2].title}</h3>
          <p class="font-body-md text-on-surface-variant">{features.features[2].longDescription}</p>
          <div class="mt-md flex flex-wrap gap-xs">
            <span class="px-sm py-1 bg-surface-container-highest text-on-primary-fixed-variant rounded-full text-body-sm">In Stock: Kale</span>
            <span class="px-sm py-1 bg-surface-container-highest text-on-primary-fixed-variant rounded-full text-body-sm">In Stock: Quinoa</span>
          </div>
        </div>
        <div class="flex-1 w-full h-64 md:h-full bg-surface-container-lowest rounded-xl border border-outline-variant p-md relative overflow-hidden flex flex-col">
          <div class="text-label-caps font-label-caps text-outline mb-sm">GENERATING SUGGESTION...</div>
          <div class="space-y-sm">
            <div class="h-4 bg-surface-container rounded w-3/4 animate-pulse"></div>
            <div class="h-4 bg-surface-container rounded w-1/2 animate-pulse"></div>
            <div class="h-32 bg-primary/5 rounded mt-md border border-dashed border-primary/20 flex items-center justify-center">
              <span class="material-symbols-outlined text-primary/40 text-4xl">restaurant_menu</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Waitlist Section -->
  <section class="mt-xxl px-container-padding max-w-5xl mx-auto">
    <div class="bg-surface-variant rounded-2xl p-xl md:p-xxl text-center relative overflow-hidden">
      <div class="absolute -top-12 -left-12 w-64 h-64 bg-secondary-container/30 organic-shape blur-3xl"></div>
      <div class="absolute -bottom-12 -right-12 w-64 h-64 bg-primary-container/30 organic-shape blur-3xl"></div>
      <div class="relative z-10 space-y-lg">
        <h2 class="font-h1 text-h1 text-on-surface">Experience a Sunday morning state of mind, every day.</h2>
        <p class="font-body-lg text-on-surface-variant max-w-2xl mx-auto">Join our closed beta for couples who value nutrition as much as connection.</p>
        <div class="max-w-md mx-auto flex flex-col md:flex-row gap-sm pt-md">
          <input class="flex-1 px-lg py-sm rounded-full bg-surface-container-lowest border border-outline-variant focus:border-primary focus:ring-0 text-body-md" type="email" placeholder="Email address" />
          <button class="bg-secondary text-on-secondary px-xl py-sm rounded-full font-h3 text-body-md hover:brightness-110 active:scale-95 transition-all">
            Cook Together
          </button>
        </div>
        <p class="text-body-sm text-outline">Limited to 500 households this season.</p>
      </div>
    </div>
  </section>
</BaseLayout>
