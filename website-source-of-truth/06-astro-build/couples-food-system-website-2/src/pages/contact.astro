---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/forms/ContactForm.astro';
---

<BaseLayout title="Contact | Couples Food System" description="Have questions, feedback, or just want to chat about food? We're all ears.">
  <main class="pt-24 pb-xl px-container-padding max-w-7xl mx-auto w-full">
    <!-- Hero Section -->
    <section class="mb-xl text-center md:text-left">
      <h2 class="font-h1 text-h1-mobile md:text-h1 text-primary mb-sm">Let's start a new ritual.</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">Have questions about our shared kitchen philosophy? We'd love to hear from you and help you transform your table.</p>
    </section>

    <!-- Bento Layout for Contact Content -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
      <!-- Contact Form Card -->
      <div class="md:col-span-7 cream-dark-card p-xl flex flex-col gap-lg">
        <div class="flex items-center gap-sm">
          <span class="material-symbols-outlined text-primary">mail</span>
          <h3 class="font-h3 text-h3 text-primary">Send a Note</h3>
        </div>
        <ContactForm />
      </div>
      <!-- Side Bento Info Column -->
      <div class="md:col-span-5 flex flex-col gap-gutter">
        <!-- Image Card -->
        <div class="h-48 md:h-64 rounded-[24px] overflow-hidden relative group bg-surface-container-highest">
          <div class="w-full h-full flex items-center justify-center">
            <span class="material-symbols-outlined text-primary text-6xl">restaurant</span>
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent flex items-end p-lg">
            <p class="text-white font-body-sm italic">"Nourishment is the ultimate love language."</p>
          </div>
        </div>
        <!-- Info Cards Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-gutter">
          <div class="cream-dark-card p-md flex flex-col gap-base items-center text-center group hover:border-primary transition-colors cursor-pointer">
            <div class="w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center">
              <span class="material-symbols-outlined text-primary">chat_bubble</span>
            </div>
            <p class="font-label-caps text-on-surface-variant">TEXT US</p>
            <p class="font-h3 text-h3 text-primary">+1 (555) MEAL-PLAN</p>
          </div>
          <div class="cream-dark-card p-md flex flex-col gap-base items-center text-center group hover:border-primary transition-colors cursor-pointer">
            <div class="w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center">
              <span class="material-symbols-outlined text-primary">public</span>
            </div>
            <p class="font-label-caps text-on-surface-variant">FOLLOW</p>
            <p class="font-h3 text-h3 text-primary">@sundaymorning</p>
          </div>
        </div>
        <!-- Map/Location Card -->
        <div class="cream-dark-card p-lg flex-1 flex flex-col gap-sm">
          <div class="flex justify-between items-start">
            <div>
              <p class="font-label-caps text-on-surface-variant">STUDIO</p>
              <p class="font-body-md text-on-surface">The Sunhouse, Arts District<br/>Portland, OR 97204</p>
            </div>
            <div class="w-12 h-12 bg-secondary/10 rounded-xl flex items-center justify-center">
              <span class="material-symbols-outlined text-secondary">location_on</span>
            </div>
          </div>
          <div class="mt-base bg-surface-container-highest/50 h-24 rounded-xl border border-outline-variant/30 flex items-center justify-center">
            <span class="material-symbols-outlined text-primary/30">map</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Waitlist CTA Section -->
    <section class="mt-xl bg-primary text-on-primary rounded-[32px] p-xl flex flex-col md:flex-row items-center justify-between gap-xl relative overflow-hidden">
      <div class="relative z-10 text-center md:text-left">
        <h2 class="font-h2 text-h2-mobile md:text-h2 mb-base">Ready for better Sundays?</h2>
        <p class="font-body-lg text-body-lg opacity-90 max-w-md">Join 1,200+ couples in our private beta. We're launching the full system this Autumn.</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-md relative z-10 w-full md:w-auto">
        <input class="bg-white/10 border border-white/20 rounded-full px-xl py-md text-white placeholder:text-white/60 focus:outline-none focus:bg-white/20 transition-all w-full md:w-64" type="email" placeholder="Your email address" />
        <button class="bg-secondary text-white px-xl py-md rounded-full font-h3 hover:bg-secondary/90 transition-all active:scale-95 whitespace-nowrap">
          Cook Now
        </button>
      </div>
      <div class="absolute -bottom-12 -right-12 w-48 h-48 bg-white/5 rounded-full blur-3xl"></div>
    </section>
  </main>
</BaseLayout>
