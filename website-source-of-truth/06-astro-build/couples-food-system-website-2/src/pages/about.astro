---
import BaseLayout from '../layouts/BaseLayout.astro';
import Waitlist from '../components/sections/Waitlist.astro';
import WaitlistForm from '../components/forms/WaitlistForm.astro';
---

<BaseLayout title="Our Story | Couples Food System" description="We built Couples Food System because sharing a meal should bring couples together, not create arguments.">
  <main class="pt-24 pb-20 grainy">
    <!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-container-padding py-xl text-center">
      <div class="mb-xl inline-block">
        <div class="w-32 h-32 md:w-48 md:h-48 rounded-full bg-surface-container-highest flex items-center justify-center border-4 border-primary-container mx-auto">
          <span class="material-symbols-outlined text-primary text-6xl">restaurant</span>
        </div>
      </div>
      <h1 class="font-h1-mobile md:font-h1 text-h1-mobile md:text-h1 text-on-surface mb-base max-w-2xl mx-auto">
        Transforming meal planning into a <span class="text-primary italic">shared ritual</span>.
      </h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl mx-auto opacity-80">
        Born from the kitchen of two humans who wanted to cook better, together. Sunday Morning is a philosophy of collaborative, adaptive nutrition.
      </p>
    </section>

    <!-- The Why -->
    <section class="max-w-7xl mx-auto px-container-padding py-xl">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-xl items-center">
        <div class="md:col-span-7">
          <div class="bg-surface-container-low rounded-[40px] p-xl border border-outline-variant relative overflow-hidden">
            <div class="relative z-10">
              <span class="font-label-caps text-label-caps text-secondary mb-sm block">THE PROBLEM</span>
              <h2 class="font-h2 text-h2 text-on-surface mb-md">Nutrition shouldn't be a solo mission.</h2>
              <p class="font-body-md text-body-md text-on-surface-variant space-y-4">
                Most fitness apps are designed for the individual—the "me" instead of the "us." They track data point-by-point, calorie-by-calorie, turning food into a math problem.
                <br/><br/>
                We realized that for couples, the biggest friction isn't what to eat, but the <span class="font-semibold text-primary">cognitive load of deciding together</span>. We wanted to build something that honors the shared experience of eating.
              </p>
            </div>
            <div class="absolute -bottom-10 -right-10 opacity-10">
              <span class="material-symbols-outlined text-[120px]" style="font-variation-settings: 'FILL' 1;">restaurant</span>
            </div>
          </div>
        </div>
        <div class="md:col-span-5 grid grid-cols-1 gap-lg">
          <div class="bg-primary-container/20 rounded-[32px] p-lg border border-primary-container/30">
            <span class="material-symbols-outlined text-primary mb-sm">favorite</span>
            <h3 class="font-h3 text-h3 text-primary mb-xs">Calm & Intentional</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant">No alerts, no guilt, no data-shaming. Just gentle nudges toward shared health.</p>
          </div>
          <div class="bg-secondary-container/20 rounded-[32px] p-lg border border-secondary-container/30">
            <span class="material-symbols-outlined text-secondary mb-sm">group</span>
            <h3 class="font-h3 text-h3 text-secondary mb-xs">Collaborative Logic</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant">Systems that learn both your preferences and merge them seamlessly into one plan.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Our Vision -->
    <section class="max-w-7xl mx-auto px-container-padding py-xl">
      <div class="text-center mb-xl">
        <h2 class="font-h1-mobile md:font-h1 text-h1-mobile md:text-h1">The Pillars of Sunday Morning</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
        <div class="md:col-span-2 bg-surface-container-highest rounded-[32px] overflow-hidden group">
          <div class="p-xl">
            <h3 class="font-h2 text-h2 text-on-primary-container mb-sm">Adaptive Synchronicity</h3>
            <p class="font-body-md text-body-md text-on-primary-container opacity-80 max-w-lg">
              Our system doesn't just suggest recipes; it adapts to your energy levels, grocery inventory, and fluctuating schedules as a unit.
            </p>
          </div>
          <div class="px-xl pb-xl">
            <div class="w-full h-48 bg-surface-container rounded-2xl flex items-center justify-center">
              <span class="text-on-surface-variant/50">Adaptive Planning</span>
            </div>
          </div>
        </div>
        <div class="bg-secondary-container rounded-[32px] p-xl flex flex-col justify-between text-on-secondary-container">
          <div>
            <span class="material-symbols-outlined text-4xl mb-md">eco</span>
            <h3 class="font-h3 text-h3 mb-sm">Minimalist Waste</h3>
            <p class="font-body-sm text-body-sm">Intelligent shopping lists that prioritize what's already in your pantry before suggesting new purchases.</p>
          </div>
          <div class="mt-lg">
            <span class="font-label-caps text-[48px] opacity-20 font-bold block leading-none">01</span>
          </div>
        </div>
        <div class="bg-surface-container rounded-[32px] p-xl flex flex-col justify-between border border-outline-variant">
          <div>
            <span class="material-symbols-outlined text-primary text-4xl mb-md">volunteer_activism</span>
            <h3 class="font-h3 text-h3 text-on-surface mb-sm">Shared Labor</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant">Breaking down recipes into 'prep together' workflows to make cooking a connection point.</p>
          </div>
          <div class="mt-lg">
            <span class="font-label-caps text-[48px] opacity-10 font-bold block leading-none text-primary">02</span>
          </div>
        </div>
        <div class="md:col-span-2 bg-primary rounded-[32px] p-xl text-on-primary relative overflow-hidden">
          <div class="max-w-md relative z-10">
            <h3 class="font-h2 text-h2 mb-sm">Our Mission</h3>
            <p class="font-body-lg text-body-lg opacity-90">
              To replace the stress of "What's for dinner?" with the warmth of "Let's cook this together." We are building tools for the modern partnership.
            </p>
          </div>
          <div class="absolute -right-20 -bottom-20 opacity-10">
            <span class="material-symbols-outlined text-[300px]">auto_awesome</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Waitlist CTA -->
    <section class="max-w-5xl mx-auto px-container-padding py-xl text-center">
      <div class="bg-surface-container-low border border-outline-variant rounded-[48px] p-xl md:p-32">
        <h2 class="font-h2 text-h2 mb-md">Ready to start your ritual?</h2>
        <p class="font-body-md text-body-md text-on-surface-variant mb-xl max-w-lg mx-auto">
          We're currently in closed beta, refining the experience for a small cohort of intentional couples. Join the waitlist for the next wave of access.
        </p>
        <WaitlistForm />
        <p class="mt-lg font-body-sm text-body-sm text-on-surface-variant opacity-60">Join 1,200+ couples designing better lives.</p>
      </div>
    </section>
  </main>
</BaseLayout>
