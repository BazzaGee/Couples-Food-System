---
import BaseLayout from '../layouts/BaseLayout.astro';
import faq from '../data/faq.json';
import Waitlist from '../components/sections/Waitlist.astro';
import WaitlistForm from '../components/forms/WaitlistForm.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.faq.map(q => ({
    "@type": "Question",
    "name": q.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": q.answer
    }
  }))
};
---

<BaseLayout title="FAQ | Couples Food System" description="Everything you need to know about Couples Food System — Beta access, features, privacy, and more." schema={faqSchema}>
  <main class="pt-24 pb-xl px-container-padding max-w-7xl mx-auto">
    <!-- Hero Section -->
    <section class="mb-xl text-center md:text-left flex flex-col md:flex-row md:items-center gap-xl">
      <div class="flex-1">
        <h2 class="font-h1-mobile md:font-h1 text-h1-mobile md:text-h1 text-primary mb-base">Questions & Clarity</h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">
          Everything you need to know about ritualizing your kitchen culture. We're here to help you and your partner navigate the Sunday Morning experience.
        </p>
      </div>
      <div class="hidden md:block w-48 h-48 rounded-full overflow-hidden border-4 border-surface-container-highest bg-surface-container-highest flex items-center justify-center">
        <span class="material-symbols-outlined text-primary text-6xl">help</span>
      </div>
    </section>

    <!-- Category Chips -->
    <section class="mb-lg overflow-x-auto hide-scrollbar -mx-container-padding px-container-padding">
      <div class="flex gap-sm pb-xs">
        <button class="faq-filter-chip bg-primary text-on-primary px-lg py-sm rounded-full font-label-caps whitespace-nowrap transition-all" data-category="all">All Questions</button>
        {faq.categories.map((cat) => (
          <button class="faq-filter-chip bg-surface-container text-on-surface-variant px-lg py-sm rounded-full font-label-caps whitespace-nowrap hover:bg-surface-container-high transition-all" data-category={cat.id}>{cat.label}</button>
        ))}
      </div>
    </section>

    <!-- FAQ Accordion Container -->
    <section class="grid grid-cols-1 md:grid-cols-1 gap-base mb-xl" id="faq-list">
      {faq.faq.map((item) => (
        <details class="faq-accordion-item group bg-cream-dark border border-outline-variant rounded-xl overflow-hidden transition-all duration-300" data-category={item.category}>
          <summary class="flex items-center justify-between p-lg cursor-pointer list-none">
            <h3 class="font-h3 text-h3 text-primary group-hover:opacity-80 transition-opacity">{item.question}</h3>
            <span class="material-symbols-outlined text-primary transition-transform duration-300">expand_more</span>
          </summary>
          <div class="px-lg pb-lg text-on-surface-variant font-body-md">
            {item.answer}
          </div>
        </details>
      ))}
    </section>

    <!-- Waitlist CTA Section -->
    <section class="bg-secondary-container rounded-xl p-xl flex flex-col md:flex-row items-center justify-between gap-lg relative overflow-hidden">
      <div class="absolute -right-16 -top-16 w-64 h-64 bg-secondary opacity-10 rounded-full blur-3xl"></div>
      <div class="relative z-10 text-center md:text-left">
        <h3 class="font-h2 text-h2 text-on-secondary-container mb-xs">Ready to ritualize?</h3>
        <p class="font-body-md text-on-secondary-container opacity-90">Join 4,000+ couples designing a better kitchen culture.</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-md w-full md:w-auto relative z-10">
        <input class="bg-surface-container-lowest border-none rounded-lg px-md py-sm w-full md:w-64 focus:ring-2 focus:ring-secondary" type="email" placeholder="email@example.com" />
        <button class="bg-secondary text-on-secondary px-xl py-sm rounded-lg font-h3 text-h3 whitespace-nowrap active:scale-95 transition-transform">Get Access</button>
      </div>
    </section>
  </main>

  <script>
    // FAQ Filtering Logic
    const filterChips = document.querySelectorAll('.faq-filter-chip');
    const faqItems = document.querySelectorAll('.faq-accordion-item');

    filterChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const category = chip.getAttribute('data-category');
        
        filterChips.forEach(c => {
          c.classList.remove('bg-primary', 'text-on-primary');
          c.classList.add('bg-surface-container', 'text-on-surface-variant');
        });
        chip.classList.add('bg-primary', 'text-on-primary');
        chip.classList.remove('bg-surface-container', 'text-on-surface-variant');

        faqItems.forEach(item => {
          if (category === 'all' || item.getAttribute('data-category') === category) {
            item.classList.remove('hidden');
            item.classList.add('block');
          } else {
            item.classList.add('hidden');
            item.classList.remove('block');
          }
        });
      });
    });

    // Close other accordion items when one opens
    faqItems.forEach(item => {
      item.addEventListener('toggle', () => {
        if (item.open) {
          faqItems.forEach(otherItem => {
            if (otherItem !== item) otherItem.removeAttribute('open');
          });
        }
      });
    });
  </script>
</BaseLayout>
