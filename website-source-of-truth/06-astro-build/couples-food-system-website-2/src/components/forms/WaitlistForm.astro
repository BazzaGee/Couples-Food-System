---
const formspreeEndpoint = 'https://formspree.io/f/barrydgrottis@gmail.com';
---

<form action={formspreeEndpoint} method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-md text-left">
  <div class="space-y-xs">
    <label class="font-label-caps text-on-surface-variant ml-xs">Your Email</label>
    <input class="w-full bg-surface-container-low border-outline-variant rounded-xl p-md focus:ring-2 focus:ring-primary focus:border-primary transition-all" type="email" name="email" id="waitlist_email" required placeholder="you@home.com" />
  </div>
  <div class="space-y-xs">
    <label class="font-label-caps text-on-surface-variant ml-xs">Partner's Email (Optional)</label>
    <input class="w-full bg-surface-container-low border-outline-variant rounded-xl p-md focus:ring-2 focus:ring-primary focus:border-primary transition-all" type="email" name="partner_email" id="partner_email" placeholder="them@home.com" />
  </div>
  <div class="md:col-span-2 space-y-xs">
    <label class="font-label-caps text-on-surface-variant ml-xs">Primary Kitchen Goal</label>
    <select name="primary_goal" id="goal" required class="w-full bg-surface-container-low border-outline-variant rounded-xl p-md focus:ring-2 focus:ring-primary focus:border-primary transition-all appearance-none">
      <option value="" disabled selected>What is your shared primary goal?</option>
      <option value="Stop arguing about dinner">Ending the "What's for dinner?" debate</option>
      <option value="Different portion/diet goals">Better health as a couple</option>
      <option value="Reduce food waste">Reducing food waste together</option>
    </select>
  </div>
  <button class="md:col-span-2 bg-secondary text-on-secondary font-h3 text-h3 py-md rounded-xl hover:opacity-90 active:scale-[0.98] transition-all shadow-md" type="submit">
    Secure Beta Access
  </button>
</form>
